# Copy to apps/server/.env  (cp apps/server/.env.example apps/server/.env)
# .env is git-ignored. Restart the server after editing it: env is read once at startup.

# --- Server ---
PORT=8787
# Comma-separated list of browser origins allowed by CORS. The first one is
# also used as PayPal's return/cancel URL base.
WEB_ORIGIN=http://localhost:5173
# Number of reverse proxies in front of the app when deployed (0 locally, 1 on Render/Fly).
TRUST_PROXY=0

# --- AI provider ---
# mock      = deterministic rule-based adapter, no key needed (clearly labelled in the UI)
# gemini    = Google Gemini API. Free tier, no card: create a key at aistudio.google.com.
#             Free-tier prompts may be used by Google to improve its products.
# anthropic = Claude via the Anthropic API (needs prepaid API credit)
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Models to try in order when the primary is overloaded or out of free quota (comma-separated).
# See which names your key can use: npm run ai:check -w @cartguardian/server -- models
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
# Max wait per model while fallbacks remain; AI_TIMEOUT_MS below is the total for one trial.
GEMINI_PER_MODEL_TIMEOUT_MS=12000
# How much the model reasons before answering: minimal | low | medium | high | default (model decides, slowest)
GEMINI_THINKING_LEVEL=low
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Total time one trial may take (all models + one repair attempt).
AI_TIMEOUT_MS=30000

# --- PayPal (Sandbox only) ---
# developer.paypal.com > Apps & Credentials > Sandbox tab > your REST app.
# The Client ID is public (sent to the browser). The Secret must stay here.
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_TIMEOUT_MS=15000

# --- Abuse limits (per client IP) ---
RATE_LIMIT_EVALUATIONS_PER_MINUTE=10
RATE_LIMIT_ORDERS_PER_MINUTE=20
